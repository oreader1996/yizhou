{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "译舟",
  "version": "0.1.0",
  "identifier": "app.yizhou.translator",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1 --strictPort",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "译舟", "width": 420, "height": 660, "decorations": false }],
    "security": { "csp": "default-src 'self'; style-src 'self'; connect-src 'self' ipc: http://ipc.localhost" }
  },
  "bundle": { "active": true, "targets": ["deb", "dmg", "nsis"], "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"], "macOS": { "minimumSystemVersion": "14.0" } }
}
